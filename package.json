{
  "name": "@leonhardthust/dsh-decision-engine",
  "version": "1.9.0",
  "description": "dsh-decision-engine: a cheap judgement layer for DeepSeek Harness — a small decision model answers structured questions before the main model acts, so calls can be allowed, escalated, rerouted to a cheaper model, or skipped. All eight decision points (tool authorization, model routing, delegation, compaction, turn continuation, retrieval, skill pick, COT translation) are implemented and individually switchable. Works against any service exposing a decision endpoint: built-in presets (system one, bamboonode, SiliconFlow, Silicon Flow) or a custom base URL.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./providers": "./lib/providers.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "config.example.yml",
    "icon.svg",
    "locale",
    "docs",
    "scripts/migrate-profile.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "decision-engine",
    "startlux",
    "bamboo",
    "bamboo-relay",
    "decisions",
    "system-one",
    "system-1",
    "typesafe",
    "jev",
    "siliconflow",
    "siliconflow-cn",
    "kev-4b",
    "provider",
    "custom-base-url",
    "tool-approval",
    "risk-gating",
    "model-routing",
    "compaction",
    "session-title",
    "translation-gate"
  ],
  "engines": {
    "node": ">=20.3.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "license": "MIT",
  "author": "zuosus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonhardtHUST/dsh-decision-engine.git"
  },
  "bugs": {
    "url": "https://github.com/LeonhardtHUST/dsh-decision-engine/issues"
  },
  "homepage": "https://github.com/LeonhardtHUST/dsh-decision-engine#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "vp config --no-agent",
    "commitlint": "commitlint",
    "test": "node --test --test-timeout=60000 test/*.test.js",
    "verify:endpoint": "node scripts/verify-endpoint.mjs",
    "verify:wiring": "node scripts/verify-wiring.mjs",
    "verify:guard": "node scripts/verify-guard-scenarios.mjs bench/guard-revision",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "pack:release": "vp pm pack --pack-destination release-artifacts --json",
    "verify": "node --test --test-timeout=60000 test/*.test.js && node scripts/verify-wiring.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-angular": "^21.2.4",
    "vite-plus": "1.6.0"
  }
}
